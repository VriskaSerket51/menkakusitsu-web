{
  "name": "menkakusitsu-web",
  "author": "VriskaSerket51",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev --host --port 3000",
    "build": "react-router typegen && tsc && react-router build && node scripts/check-build.mjs",
    "lint": "eslint src --max-warnings 0",
    "preview": "vite preview --outDir dist/client --host --port 3000",
    "start": "npm run build && npm run preview",
    "generate:api": "node scripts/generate-api.mjs",
    "check:api": "node scripts/generate-api.mjs --check",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "react-router typegen && tsc -p tsconfig.api-tests.json && node --test test/*.test.mjs",
    "test:api-integration": "node test/login.integration.mjs",
    "check:build": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@react-router/node": "^7.18.4",
    "@tsparticles/engine": "^4.4.0",
    "@tsparticles/react": "^4.4.0",
    "audio-recorder-polyfill": "^0.4.1",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "firebase": "^12.19.0",
    "notistack": "^3.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "sha3": "^2.1.4",
    "topbar": "^3.0.1",
    "tsparticles": "^4.4.0",
    "zustand": "^5.0.15",
    "isbot": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^7.18.4",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "orval": "8.36.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-compression2": "^2.5.3"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "overrides": {
    "@scalar/json-magic": {
      "undici": "^7.29.0"
    }
  }
}
