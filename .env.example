VITE_WEB_TITLE="Example Title"
VITE_WEB_PREFIX="https://example.com"
VITE_API_PREFIX="https://example.com"
# 로컬 개발: WEB_PREFIX=http://localhost:3000 (API 설정), VITE_API_PREFIX=http://localhost:<API 포트>

# Firebase는 개발 모드 및 로컬 주소에서 기본 비활성화됩니다.
# 로컬에서 실제 Firebase 테스트가 필요한 경우에만 설정하세요.
# VITE_FIREBASE_ENABLED=true
